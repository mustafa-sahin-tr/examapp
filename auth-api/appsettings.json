{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthApiBaseUrl": "http://auth-api:5079",
  "RateLimiting": {
    "AuthAttempts": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Registration": {
    "MinimumResponseMilliseconds": 1500
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=exam_pg_container;Port=5432;Database=identity;Username=examuser;Password="
  },
  "Jwt": {
    "Issuer": "ExamApp",
    "Audience": "ExamAppUsers"
  },
  "MinioConfig": {
    "Endpoint": "minio:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "exam-questions",
    "BaseUrl": "http://localhost/minio-api"
  },
  "Keycloak": {
    "Authority": "http://localhost:5678/realms/exam-realm",
    "Host": "http://keycloak:8080",
    "Realm": "exam-realm",
    "TokenUrl": "realms/exam-realm/protocol/openid-connect/token",
    "UserUrl": "admin/realms/exam-realm/users",
    "RealmRolesUrl": "admin/realms/exam-realm/roles",
    "LogoutUrl": "admin/realms/exam-realm/users/{0}/logout",
    "RedirectUri": "http://localhost:5678/app/callback",
    "ClientId": "exam-client",
    "ClientSecret": "",
    "AdminClientId": "exam-admin",
    "AdminClientSecret": "",
    "ExcludedRoles": [
      "default-roles-exam-realm",
      "uma_authorization",
      "offline_access"
    ]
  },
  "PrivilegedAudit": {
    "KnownAccounts": []
  }
}