<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- long-running container tests: don't run them alongside the fast unit suite by default -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- issue #98: whiteboard hub uçtan uca testi (TestServer üzerinden iki SignalR istemcisi) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <PackageReference Include="Respawn" Version="6.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../api/ExamApp.Api/ExamApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- issue #365 (S2): SDK'dan bagimsiz SigV4 presign dogrulayicisi (ExamApp.Api.Tests ile paylasilir) -->
    <Compile Include="../ExamApp.Api.Tests/Support/SigV4PresignVerifier.cs" Link="Infrastructure/SigV4PresignVerifier.cs" />
  </ItemGroup>

</Project>
