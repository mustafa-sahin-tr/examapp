{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=exam_pg_container;Port=5432;Database=worksheet;Username=examuser;Password="
  },
  "BadgeApiBaseUrl": "http://exam-badge-api:8006",
  "TeacherApprovals": {
    "SchoolRequestCooldownHours": 24
  },
  "AdminDataAccessLog": {
    "RetentionDays": 180,
    "DeleteBatchSize": 5000,
    "Cron": "30 3 * * *"
  },
  "RateLimiting": {
    "AdminUserList": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "StoreTimeoutMilliseconds": 500
    },
    "AdminPasswordReset": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AdminAccountStatus": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "AdminStudentSchool": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "StudentSelfReset": {
      "PermitLimit": 1,
      "WindowSeconds": 3600
    },
    "StudyLinkWrite": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "ExamApp",
    "Audience": "ExamAppUsers"
  },
  "AuthApiBaseUrl": "http://auth-api:5079",
  "Redis": {
    "Configuration": "redis:6379"
  },
  "MinioConfig": {
    "Endpoint": "minio:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "exam-questions",
    "BaseUrl": "http://localhost/minio-api"
  },
  "Keycloak": {
    "Authority": "http://localhost:5678/realms/exam-realm",
    "Host": "http://keycloak:8080",
    "Realm": "exam-realm",
    "TokenUrl": "realms/exam-realm/protocol/openid-connect/token",
    "UserUrl": "admin/realms/exam-realm/users",
    "RealmRolesUrl": "admin/realms/exam-realm/roles",
    "LogoutUrl": "admin/realms/exam-realm/users/{0}/logout",
    "RedirectUri": "http://localhost:5678/app/callback",
    "ClientId": "exam-client",
    "ClientSecret": "",
    "AdminClientId": "exam-admin",
    "AdminClientSecret": "",
    "ExcludedRoles": [
      "default-roles-exam-realm",
      "uma_authorization",
      "offline_access"
    ]
  },
  "Video": {
    "Provider": "Jitsi",
    "JoinWindowBeforeMinutes": 15,
    "JoinWindowAfterMinutes": 30,
    "Jitsi": {
      "PublicBaseUrl": "http://localhost:8000",
      "XmppDomain": "meet.jitsi",
      "AppId": "examapp",
      "TokenLifetimeMinutes": 60
    }
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "models/gemini-3.5-flash-lite",
    "Ttl": "604800s",
    "ApiKey": ""
  }
}