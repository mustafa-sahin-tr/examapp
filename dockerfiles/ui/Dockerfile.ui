# syntax=docker/dockerfile:1
# Use the Node.js image for building Angular
FROM node:24 AS build

# Set the working directory in the container
WORKDIR /app

# TLS doğrulaması açık kalır (#553). Kurumsal proxy kendi sertifikasıyla araya giriyorsa kök CA'yı
# BuildKit secret'ı olarak ver; imaja yalnız sistem CA deposu üzerinden girer, repoya girmez:
#   docker build --secret id=corp_ca,src=/yol/kurum-ca.pem dockerfiles/<uygulama>
RUN --mount=type=secret,id=corp_ca,required=false \
    if [ -s /run/secrets/corp_ca ]; then \
        cp /run/secrets/corp_ca /usr/local/share/ca-certificates/corp-ca.crt && update-ca-certificates; \
    fi
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Install Angular CLI
RUN npm install -g @angular/cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        nano \
        git \
        net-tools \
    && rm -rf /var/lib/apt/lists/*
# RUN ng analytics disable --global
# RUN ng completion script
# # Create a new Angular project
# RUN ng new client --skip-install --routing=false --style=scss --ssr=false

# Change directory to the project folder
# WORKDIR /app/client
# apt-get install -y iptools-ping
# apt-get install net-tools
# Expose port 4200 for the Angular development server
EXPOSE 4200

# Command to start the Angular development server
# CMD ["ng", "serve", "--host", "0.0.0.0"]
CMD ["sleep", "infinity"]
