<Project Sdk="Aspire.AppHost.Sdk/13.5.0">

  <ItemGroup>
    <ProjectReference Include="..\api\ExamApp.Api\ExamApp.Api.csproj" />
    <ProjectReference Include="..\Services\BadgeService\BadgeService.csproj" />
    <ProjectReference Include="..\Services\OutboxPublisher\OutboxPublisherService.csproj" />
    <ProjectReference Include="..\Services\Gateway\Gateway.csproj" />
    <!-- auth-api's csproj is also named ExamApp.Api.csproj (different folder),
         which would otherwise collide with api/ExamApp.Api's generated
         Projects.ExamApp_Api type — disambiguated explicitly. -->
    <ProjectReference Include="..\auth-api\ExamApp.Api.csproj" AspireProjectMetadataTypeName="AuthApi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.5.0-preview.1.26417.10" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.0" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.5.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>0ee8da4a-8186-4aa1-804c-8a34c6f0b975</UserSecretsId>
  </PropertyGroup>

</Project>
