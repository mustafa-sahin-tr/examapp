{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "exam-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/exam-app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*.woff2",
                "input": "node_modules/@excalidraw/excalidraw/dist/prod/fonts",
                "output": "excalidraw-assets/fonts",
                "ignore": [
                  "Xiaolai/**"
                ]
              }
            ],
            "styles": [
              "node_modules/quill/dist/quill.snow.css",
              "src/styles.scss",
              {
                "input": "node_modules/@excalidraw/excalidraw/dist/prod/index.css",
                "bundleName": "excalidraw",
                "inject": false
              }
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "react",
              "react-dom",
              "react-dom/client",
              "@braintree/sanitize-url",
              "canvas-roundrect-polyfill",
              "es6-promise-pool",
              "fuzzy",
              "lodash.debounce",
              "lodash.throttle",
              "pica",
              "png-chunk-text",
              "png-chunks-encode",
              "png-chunks-extract",
              "use-sync-external-store/shim/with-selector.js",
              "quill-delta",
              "jszip"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "ssr": {
              "entry": "src/server.ts"
            },
            "prerender": true,
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1", "angular-app"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "3MB",
                  "maximumError": "6MB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                }
              ],
              "styles": [
                "src/styles.scss"
              ],
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "allowedHosts": ["localhost", "127.0.0.1", "angular-app"],
            "headers": {
              "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' http://localhost:8000; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ws://localhost:*; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com http://localhost:8000; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /csp-report",
              "X-Frame-Options": "SAMEORIGIN",
              "X-Content-Type-Options": "nosniff"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "exam-app:build:production"
            },
            "development": {
              "buildTarget": "exam-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest",
            "browsers": ["chromiumHeadless"],
            "browserViewport": "800x600",
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}