{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=exam_pg_container;Port=5432;Database=worksheet;Username=examuser;Password="
  },
  "BadgeApiBaseUrl": "http://exam-badge-api:8006",
  "TeacherApprovals": {
    "SchoolRequestCooldownHours": 24
  },
  "AdminDataAccessLog": {
    "RetentionDays": 180,
    "DeleteBatchSize": 5000,
    "Cron": "30 3 * * *"
  },
  "SuspendedTeacherBookingSweep": {
    "Cron": "*/5 * * * *",
    "BatchSize": 500
  },
  "ExpiredTestInstanceSweep": {
    "Cron": "*/5 * * * *",
    "BatchSize": 500
  },
  "ParentHomeworkOverdueSweep": {
    "Cron": "*/15 * * * *",
    "LookbackDays": 3,
    "BatchSize": 200
  },
  "RateLimiting": {
    "AdminUserList": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "StoreTimeoutMilliseconds": 500
    },
    "AdminPasswordReset": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AdminAccountStatus": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "StudyBookPageLookup": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "StudentSchoolRequestList": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "AdminStudentSchool": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "StudentSelfReset": {
      "PermitLimit": 1,
      "WindowSeconds": 3600
    },
    "StudyLinkWrite": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "TeacherActivity": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "WorksheetCommentWrite": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "WorksheetCommentRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "DirectMessageSend": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "DirectMessageReport": {
      "PermitLimit": 20,
      "WindowSeconds": 3600
    },
    "DirectMessageRead": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "DirectMessageBlock": {
      "PermitLimit": 30,
      "WindowSeconds": 3600
    },
    "DirectMessageSearch": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "ParentLinkRedeem": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "ParentLinkInvite": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "ParentLinks": {
    "InviteCodePepper": "",
    "RedeemGuard": {
      "MaxFailuresPerAccount": 20,
      "AccountWindowSeconds": 86400,
      "GlobalFailureThreshold": 200,
      "GlobalWindowSeconds": 60,
      "BreakerCooldownSeconds": 120
    }
  },
  "DirectMessaging": {
    "AllowSameSchoolMessaging": false,
    "Quotas": {
      "NewConversationsPerDay": 10,
      "MessagesPerConversationPerHour": 30
    }
  },
  "Dashboard": {
    "TimeZone": "Europe/Istanbul",
    "TeacherActivityCacheSeconds": 60
  },
  "DailyQuestions": {
    "QuestionCount": 5,
    "RecentAnswerExclusionDays": 14
  },
  "Jwt": {
    "Issuer": "ExamApp",
    "Audience": "ExamAppUsers"
  },
  "AuthApiBaseUrl": "http://auth-api:5079",
  "Redis": {
    "Configuration": "redis:6379"
  },
  "MinioConfig": {
    "Endpoint": "minio:9000",
    "PresignEndpoint": "",
    "PresignImageUrls": true,
    "PresignAccessKey": "",
    "PresignSecretKey": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "exam-questions"
  },
  "Keycloak": {
    "Authority": "http://localhost:5678/realms/exam-realm",
    "Host": "http://keycloak:8080",
    "Realm": "exam-realm",
    "TokenUrl": "realms/exam-realm/protocol/openid-connect/token",
    "UserUrl": "admin/realms/exam-realm/users",
    "RealmRolesUrl": "admin/realms/exam-realm/roles",
    "LogoutUrl": "admin/realms/exam-realm/users/{0}/logout",
    "RedirectUri": "http://localhost:5678/app/callback",
    "ClientId": "exam-client",
    "ClientSecret": "",
    "AdminClientId": "exam-admin",
    "AdminClientSecret": "",
    "ServiceClientId": "exam-service",
    "ServiceClientSecret": "",
    "ExcludedRoles": [
      "default-roles-exam-realm",
      "uma_authorization",
      "offline_access"
    ]
  },
  "Video": {
    "Provider": "Jitsi",
    "JoinWindowBeforeMinutes": 15,
    "JoinWindowAfterMinutes": 30,
    "Jitsi": {
      "PublicBaseUrl": "http://localhost:8000",
      "XmppDomain": "meet.jitsi",
      "AppId": "examapp",
      "TokenLifetimeMinutes": 60
    }
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "models/gemini-3.5-flash-lite",
    "Ttl": "604800s",
    "ApiKey": ""
  }
}