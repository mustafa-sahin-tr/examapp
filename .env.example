# Local docker-compose infrastructure credentials.
# Copy to `.env` (git-ignored) before running `docker-compose up`:
#   cp .env.example .env
# These are LOCAL DEV defaults only — never reuse them for staging/prod.

# --- PostgreSQL (shared by the API, auth-api and Keycloak) ---
POSTGRES_USER=examuser
POSTGRES_PASSWORD=exampass
POSTGRES_DB=worksheet

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@exam.com
PGADMIN_DEFAULT_PASSWORD=adminpass

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rabbituser
RABBITMQ_DEFAULT_PASS=rabbitpass

# --- Keycloak bootstrap admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Keycloak client secrets (issue #238) ---
# Dev-only values — MUST match deploy/keycloak/import/realm-export.json's
# exam-client / exam-admin "secret" fields so the imported realm actually
# authenticates. Never reuse these outside local dev.
KEYCLOAK_CLIENT_SECRET=devOnlyExamClientSecretChangeMe12345678
KEYCLOAK_ADMIN_CLIENT_SECRET=devOnlyExamAdminClientSecretChangeMe12345678

# --- Redis ---
REDIS_PASSWORD=MyStrongRedisPassword

# --- Test verisi (issue #217): `dotnet run -- seed-teachers` ortak hesap parolasi ---
# Bu dosyaya YAZILMAZ: CLI host'ta calisir, exam API .env yuklemez ve docker-compose bu degeri
# container'a gecirmez. Yalnizca su iki yol gecerlidir (koda/commit'e asla girmez):
#   ortam degiskeni:  SeedData__Password=<parola> dotnet run -- seed-teachers ...
#   user-secrets:     cd api/ExamApp.Api && dotnet user-secrets set "SeedData:Password" "<parola>"

# --- Jitsi self-host (issue #97) ---
# Public URL the browser + exam-dotnet-api both use to reach jitsi-web.
# jitsi-web's PUBLIC_URL and Video__Jitsi__PublicBaseUrl are both sourced
# from this single value so they can never drift apart.
JITSI_PUBLIC_URL=http://localhost:8000

# Inter-component secrets (prosody, jicofo, jvb). Dev-only placeholder values below (ChangeMe).
# Rotate/randomize for anything beyond a single dev machine.
JICOFO_COMPONENT_SECRET=jicofoComponentSecretChangeMe
JICOFO_AUTH_PASSWORD=jicofoAuthPasswordChangeMe
JVB_AUTH_PASSWORD=jvbAuthPasswordChangeMe

# JWT auth for meeting rooms (ENABLE_AUTH=1, ENABLE_GUESTS=0 - every participant needs a token from exam-dotnet-api).
# JWT expects: iss=JITSI_JWT_APP_ID, aud=jitsi, sub=meet.jitsi (XMPP_DOMAIN).
# JITSI_JWT_APP_SECRET must be >= 32 bytes for HS256 - dev-only ChangeMe default below, change for anything beyond local dev.
JITSI_JWT_APP_ID=examapp
JITSI_JWT_APP_SECRET=devOnlyJitsiJwtSecretChangeMe1234
JITSI_ROOM_SECRET=devOnlyJitsiRoomSecretChangeMe12
