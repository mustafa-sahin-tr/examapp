{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve --host 0.0.0.0",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    },
    {
      // Run the whole xUnit suite and show output in the terminal.
      // To debug a single test with breakpoints, use the Testing panel
      // (C# Dev Kit) → right-click the test → "Debug Test" instead.
      "name": ".NET: run all tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": ["test", "${workspaceFolder}/ExamApp.slnx", "--nologo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // Debug the test project you're currently working in. Set a breakpoint
      // in a test, hit F5, pick this config. (Runs ExamApp.Api.Tests by default —
      // change the path for another project.)
      "name": ".NET: debug tests (ExamApp.Api.Tests)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": ["test", "${workspaceFolder}/tests/ExamApp.Api.Tests", "--nologo"],
      "cwd": "${workspaceFolder}/tests/ExamApp.Api.Tests",
      "console": "integratedTerminal",
      "env": { "VSTEST_HOST_DEBUG": "0" }
    },
    {
      // Full coverage run + HTML report (opens in browser). Needs:
      //   dotnet tool install --global dotnet-reportgenerator-globaltool
      "name": ".NET: test + coverage report",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/coverage.ps1",
      "cwd": "${workspaceFolder}"
    }
  ]
}
